{% comment %}
  HerbSpot.fi - Monikielinen Navigation & Footer (FI/EN/RU)
  Käyttö: Kopioi header.liquid ja footer.liquid tiedostoihin
{% endcomment %}

<!-- HEADER / NAVIGATION -->
<header class="site-header">
  <div class="container">
    <div class="header-content">
      <!-- Logo -->
      <div class="logo">
        <a href="/">
          {% if localization.language.iso_code == 'fi' %}
            <img src="{{ 'herbspot-logo-fi.png' | asset_url }}" alt="HerbSpot.fi">
          {% elsif localization.language.iso_code == 'en' %}
            <img src="{{ 'herbspot-logo-en.png' | asset_url }}" alt="HerbSpot.fi">
          {% elsif localization.language.iso_code == 'ru' %}
            <img src="{{ 'herbspot-logo-ru.png' | asset_url }}" alt="HerbSpot.fi">
          {% endif %}
        </a>
      </div>

      <!-- Main Navigation -->
      <nav class="main-nav">
        <ul class="nav-menu">
          {% if localization.language.iso_code == 'fi' %}
            <li><a href="/collections/all">Tuotteet</a></li>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle">Hyvinvoinnin polut</a>
              <ul class="dropdown-menu">
                <li><a href="/collections/focus">Focus</a></li>
                <li><a href="/collections/calm">Calm</a></li>
                <li><a href="/collections/sleep">Sleep</a></li>
                <li><a href="/collections/recovery">Recovery</a></li>
              </ul>
            </li>
            <li><a href="/pages/blog">Blogi</a></li>
            <li><a href="/pages/b2b">B2B</a></li>
            <li><a href="/pages/about">Tietoa meistä</a></li>
          {% elsif localization.language.iso_code == 'en' %}
            <li><a href="/collections/all">Products</a></li>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle">Wellness Paths</a>
              <ul class="dropdown-menu">
                <li><a href="/collections/focus">Focus</a></li>
                <li><a href="/collections/calm">Calm</a></li>
                <li><a href="/collections/sleep">Sleep</a></li>
                <li><a href="/collections/recovery">Recovery</a></li>
              </ul>
            </li>
            <li><a href="/pages/blog">Blog</a></li>
            <li><a href="/pages/b2b">B2B</a></li>
            <li><a href="/pages/about">About</a></li>
          {% elsif localization.language.iso_code == 'ru' %}
            <li><a href="/collections/all">Товары</a></li>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle">Пути к благополучию</a>
              <ul class="dropdown-menu">
                <li><a href="/collections/focus">Фокус</a></li>
                <li><a href="/collections/calm">Спокойствие</a></li>
                <li><a href="/collections/sleep">Сон</a></li>
                <li><a href="/collections/recovery">Восстановление</a></li>
              </ul>
            </li>
            <li><a href="/pages/blog">Блог</a></li>
            <li><a href="/pages/b2b">B2B</a></li>
            <li><a href="/pages/about">О нас</a></li>
          {% endif %}
        </ul>
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Language Selector -->
        <div class="language-selector">
          <select onchange="window.location.href=this.value">
            {% if localization.language.iso_code == 'fi' %}
              <option value="/" selected>🇫🇮 Suomi</option>
              <option value="/en/">🇬🇧 English</option>
              <option value="/ru/">🇷🇺 Русский</option>
            {% elsif localization.language.iso_code == 'en' %}
              <option value="/">🇫🇮 Suomi</option>
              <option value="/en/" selected>🇬🇧 English</option>
              <option value="/ru/">🇷🇺 Русский</option>
            {% elsif localization.language.iso_code == 'ru' %}
              <option value="/">🇫🇮 Suomi</option>
              <option value="/en/">🇬🇧 English</option>
              <option value="/ru/" selected>🇷🇺 Русский</option>
            {% endif %}
          </select>
        </div>

        <!-- Search -->
        <div class="search-box">
          <form action="/search" method="get">
            <input type="text" name="q" placeholder="{% if localization.language.iso_code == 'fi' %}Hae tuotteita...{% elsif localization.language.iso_code == 'en' %}Search products...{% elsif localization.language.iso_code == 'ru' %}Поиск товаров...{% endif %}">
            <button type="submit">🔍</button>
          </form>
        </div>

        <!-- Cart -->
        <div class="cart-icon">
          <a href="/cart">
            <span class="cart-count">{{ cart.item_count }}</span>
            🛒
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

